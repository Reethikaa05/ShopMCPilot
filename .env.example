# Real store (use a READ-ONLY key from WooCommerce > Settings > Advanced > REST API)
WOO_BASE_URL=https://your-store.example.com
WOO_CONSUMER_KEY=ck_xxx
WOO_CONSUMER_SECRET=cs_xxx
# Optional
# WOO_REVEAL_PII=1        # show unmasked customer data to the agent (default: masked)
# WOO_AUDIT_FILE=audit.jsonl
# WOO_ALLOW_INSECURE=1    # only for plain-http dev stores
